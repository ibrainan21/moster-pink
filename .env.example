# En desarrollo NO necesitas este archivo: vite.config.js ya redirige
# "/api" al backend en http://localhost:3000 automáticamente (ver el
# comentario en vite.config.js).
#
# Solo lo necesitas en producción, cuando el frontend y el backend NO
# viven en el mismo dominio. En ese caso, copia este archivo a
# ".env.production" y pon aquí la URL real de tu backend:
VITE_API_URL=https://api.tudominio.com/api
